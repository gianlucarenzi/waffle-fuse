// Waffle ModPlayer for Windows: icon and version information
#include <winver.h>

1 ICON "waffle-modplayer.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Gianluca Renzi"
            VALUE "FileDescription", "Waffle ModPlayer"
            VALUE "InternalName", "waffle-modplayer"
            VALUE "OriginalFilename", "waffle-modplayer.exe"
            VALUE "ProductName", "waffle-fuse"
            VALUE "LegalCopyright", "GPL-3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
