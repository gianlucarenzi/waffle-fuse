// waffle-fuse.exe resources: manifest and version information
#include <winuser.h>
#include <winver.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "waffle-fuse.exe.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "waffle-fuse - DrawBridge / Waffle floppy disks as Windows drives"
            VALUE "ProductName",     "waffle-fuse"
            VALUE "OriginalFilename", "waffle-fuse.exe"
            VALUE "InternalName",    "waffle-fuse"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
